## 8. Computational Demonstrations (Python/PyTorch)

The following numerical demonstrations bridge our deep theoretical frameworks to observable, computational phenomena. 

### Demo 1: Visualizing Kac-Rice on a Gaussian Field
This PyTorch script generates a stationary Gaussian Process representing a 1D slice of a loss landscape, computes gradients to locate critical points, and evaluates the local Hessian to classify them via the Morse index.

```python
import torch
import numpy as np
import matplotlib.pyplot as plt

def generate_and_analyze_landscape():
    # Set hyper-parameters
    L = 10.0      # Domain length
    N = 1000      # Spatial resolution
    l = 0.5       # Length scale of the kernel
    
    # 1. Construct the Domain and the Covariance Matrix
    x = torch.linspace(0, L, N, dtype=torch.float64)
    sqdist = (x.view(-1, 1) - x.view(1, -1)) ** 2
    K = torch.exp(-0.5 * sqdist / l**2)
    K += 1e-6 * torch.eye(N, dtype=torch.float64) # Jitter for positive-definiteness
    
    # 2. Sample the Gaussian Field (The Loss Landscape)
    L_cholesky = torch.linalg.cholesky(K)
    u = torch.randn(N, dtype=torch.float64)
    loss = L_cholesky @ u
    
    # 3. Compute Gradients and Hessians via finite differences
    dx = L / (N - 1)
    grad = torch.gradient(loss, spacing=(dx,))[0]
    hessian = torch.gradient(grad, spacing=(dx,))[0]
    
    # 4. Identify Critical Points (Zero-crossings of the gradient)
    # We find indices where the gradient changes sign
    sign_changes = torch.where(torch.diff(torch.sign(grad)) != 0)[0]
    
    minima_x, minima_y = [], []
    maxima_x, maxima_y = [], []
    
    for idx in sign_changes:
        # Check Morse Index via Hessian
        if hessian[idx] > 0: # Positive curvature -> Local Minimum (Index 0)
            minima_x.append(x[idx].item())
            minima_y.append(loss[idx].item())
        else:                # Negative curvature -> Local Maximum (Index 1 in 1D)
            maxima_x.append(x[idx].item())
            maxima_y.append(loss[idx].item())
            
    # Print Kac-Rice Theoretical Expectation vs Empirical
    expected_crits = (np.sqrt(3) * L) / (np.pi * l)
    print(f"Theoretical Kac-Rice Expectation: {expected_crits:.2f}")
    print(f"Empirical Critical Points Found: {len(sign_changes)}")
    
    # 5. Plot the landscape topography
    plt.figure(figsize=(12, 5))
    plt.plot(x.numpy(), loss.numpy(), 'k-', lw=1.5, label='Loss Landscape $\mathcal{L}(w)$')
    plt.plot(x.numpy(), grad.numpy(), 'b--', alpha=0.4, label='Gradient $\\nabla \mathcal{L}(w)$')
    plt.axhline(0, color='gray', linestyle=':')
    
    plt.scatter(minima_x, minima_y, c='green', s=80, marker='^', zorder=5, label='Minima (Index 0)')
    plt.scatter(maxima_x, maxima_y, c='red', s=80, marker='v', zorder=5, label='Maxima (Index 1)')
    
    plt.title("1D Loss Landscape Topography and Morse Classification")
    plt.xlabel("Parameter Space $w$")
    plt.ylabel("Loss / Gradient")
    plt.legend(loc='upper right')
    plt.grid(True, alpha=0.3)
    plt.show()

# Uncomment to execute

# generate_and_analyze_landscape()

```

### Demo 2: The BBP Phase Transition of the Hessian
This script simulates the Hessian matrix as learning progresses. It plants a rank-1 signal (task structure) into a high-dimensional Wigner GOE noise bulk and observes how the maximum eigenvalue escapes the bulk exactly at the theoretical BBP threshold.

```python
import torch
import numpy as np
import matplotlib.pyplot as plt

def simulate_bbp_transition():
    N = 800  # Dimension of the parameter space (Hessian size)
    thetas = torch.linspace(0.1, 3.0, 40) # Signal-to-Noise Ratios
    
    empirical_max_eigs = []
    theoretical_max_eigs = []
    
    # 1. Fix the signal direction (the "meaningful" feature direction)
    u = torch.randn(N, dtype=torch.float64)
    u = u / torch.norm(u)
    
    for theta in thetas:
        # 2. Generate the GOE Bulk (Parameter noise)
        X = torch.randn(N, N, dtype=torch.float64)
        W = (X + X.T) / np.sqrt(2 * N)
        
        # 3. Construct the Spiked Hessian
        # H = Bulk + Signal
        H = W + theta * torch.outer(u, u)
        
        # 4. Extract eigenvalues
        eigs = torch.linalg.eigvalsh(H)
        empirical_max_eigs.append(eigs.max().item())
        
        # 5. Compute rigorous theoretical limit
        t = theta.item()
        if t > 1.0:
            theoretical_max_eigs.append(t + 1.0/t)
        else:
            theoretical_max_eigs.append(2.0)
            
    # Plotting the Phase Transition
    plt.figure(figsize=(10, 6))
    plt.plot(thetas.numpy(), empirical_max_eigs, 'o', c='royalblue', 
             alpha=0.7, label='Empirical Largest Eigenvalue $\lambda_{max}$')
    plt.plot(thetas.numpy(), theoretical_max_eigs, 'r-', lw=2.5, 
             label='Theoretical BBP Limit')
    
    # Annotate the transition point
    plt.axvline(1.0, color='black', linestyle='--', alpha=0.5)
    plt.text(1.02, 3.0, 'Critical Phase Transition\n$\\theta = 1$', 
             verticalalignment='center', fontsize=11)
    
    plt.title(f"BBP Phase Transition in Random Hessians ($N={N}$)")
    plt.xlabel("Signal-to-Noise Ratio ($\\theta$)")
    plt.ylabel("Largest Eigenvalue $\lambda_{max}$")
    plt.legend(loc='upper left')
    plt.grid(True, alpha=0.3)
    plt.show()

# Uncomment to execute

# simulate_bbp_transition()

```

---

## 9. Conclusion

The transition from classical, low-dimensional optimization to modern deep learning requires a complete paradigm shift regarding landscape topography. As established via Morse Theory, the Kac-Rice framework, and Random Matrix Theory:

1. Local minima are statistically non-existent at high loss levels. 
2. The optimization bottlenecks are predominantly high-index saddle points, where geometry slows descent but eventually offers escape routes.
3. The empirical spectra of neural network Hessians split into a flat, degenerate bulk (noise) and a few highly curved outlier directions (signal), mathematically governed by the BBP phase transition.

By internalizing these topological realities, the mystery of why over-parameterized neural networks effortlessly descend towards global minima is mathematically resolved.
